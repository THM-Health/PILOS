{
	"name": "PILOS",
	"dockerComposeFile": [
		"../../docker-compose-dev.yml"
	],
    "overrideCommand": false,
	"service": "app",
	"workspaceFolder": "/var/www/html",
	"customizations": {
		"vscode": {
			"extensions": [
				"laravel.vscode-laravel",
				"mikestead.dotenv",
                "Vue.volar"
			],
			"settings": {}
		}
	},
	"remoteUser": "www-data",
    "forwardPorts": [80,1073,3000,6680,8025,8080],
    "initializeCommand": "./.devcontainer/codespaces/init.sh",
    "postCreateCommand": "./.devcontainer/codespaces/post_create.sh",
    "postStartCommand": "./.devcontainer/codespaces/post_start.sh",
    "containerEnv": {
        "SHELL": "/bin/bash"
    },
    "portsAttributes": {
        "80": {
            "label": "Application",
	        "visibility": "public",
            "onAutoForward": "openBrowser"
	    },
        "1073": {
            "label": "Vite",
            "visibility": "public"
        },
        "3000": {
            "label": "Docusaurus",
            "visibility": "private"
        },
        "6680": {
            "label": "phpLDAPadmin",
            "visibility": "private"
        },
        "8025": {
            "label": "Mailpit",
            "visibility": "private"
        },
        "8080": {
            "label": "PHPMyAdmin",
            "visibility": "private"
        }
    }
}